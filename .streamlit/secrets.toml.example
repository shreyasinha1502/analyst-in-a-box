# Streamlit Community Cloud: paste this (filled in) into the app's Secrets panel.
# For local dev, copy to .streamlit/secrets.toml (gitignored) and fill in.

# ── FREE (recommended — no credit card needed) ──
LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_..."          # get a free key at https://console.groq.com/keys

# ── or Google Gemini (also free) ──
# LLM_PROVIDER = "gemini"
# GEMINI_API_KEY = "AIza..."      # https://aistudio.google.com/apikey

# ── or paid providers ──
# LLM_PROVIDER = "anthropic"
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
